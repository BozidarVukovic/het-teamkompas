{
  "name": "het-teamkompas",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-sitemap-blogs.mjs && node scripts/sync-sitemap-kennisbank.mjs && node scripts/valideer-kennisbank.mjs && node scripts/valideer-teamscan.mjs && node scripts/valideer-teamdag.mjs && node scripts/valideer-regels.mjs && node scripts/valideer-foutafhandeling.mjs && vite build && node scripts/generate-seo-pages.js",
    "preview": "vite preview",
    "test:scroll": "node scripts/test-scrollmanager.mjs",
    "test:free-scan": "node --test tests/freeScanScoring.test.mjs",
    "test:kennisbank": "node --test tests/kennisbank.test.mjs",
    "valideer:kennisbank": "node scripts/valideer-kennisbank.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:gesprek": "node --test tests/gespreksvoorbereider.test.mjs",
    "valideer:teamscan": "node scripts/valideer-teamscan.mjs",
    "valideer:teamdag": "node scripts/valideer-teamdag.mjs",
    "test:teamdag": "node --test tests/teamdagGenerator.test.mjs",
    "test:regels": "npx -y firebase-tools@13 emulators:exec --only firestore --project teamkompas-regeltest \"node --test tests/securityRules.test.mjs\"",
    "test:app": "node --test tests/adviesApp.test.mjs",
    "valideer:regels": "node scripts/valideer-regels.mjs",
    "test:insights": "node --test tests/insightsPdf.test.mjs",
    "valideer:foutafhandeling": "node scripts/valideer-foutafhandeling.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@vercel/analytics": "^1.3.1",
    "firebase": "^10.12.0",
    "gray-matter": "^4.0.3",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.4",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "vite": "^5.4.1"
  }
}
