{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/teamscan",
      "destination": "/teamscan/index.html"
    },
    {
      "source": "/teamcoaching",
      "destination": "/teamcoaching/index.html"
    },
    {
      "source": "/teamdag",
      "destination": "/teamdag/index.html"
    },
    {
      "source": "/teamontwikkeling",
      "destination": "/teamontwikkeling/index.html"
    },
    {
      "source": "/insights-discovery-profiel",
      "destination": "/insights-discovery-profiel/index.html"
    },
    {
      "source": "/onze-aanpak",
      "destination": "/onze-aanpak/index.html"
    },
    {
      "source": "/verkennen",
      "destination": "/verkennen/index.html"
    },
    {
      "source": "/sprekers",
      "destination": "/sprekers/index.html"
    },
    {
      "source": "/sprekers/edmond-lam",
      "destination": "/sprekers/edmond-lam/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/deelnemen/:scanId",
      "destination": "/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/inspiratie",
      "destination": "/inspiratie/index.html"
    },
    {
      "source": "/kennisbank",
      "destination": "/kennisbank/index.html"
    },
    {
      "source": "/kennisbank/:type/:slug",
      "destination": "/kennisbank/:type/:slug/index.html"
    },
    {
      "source": "/gespreksvoorbereider",
      "destination": "/gespreksvoorbereider/index.html"
    },
    {
      "source": "/teamdag-generator",
      "destination": "/teamdag-generator/index.html"
    },
    {
      "source": "/kennis/growth-mindset-in-teams",
      "destination": "/kennis/growth-mindset-in-teams/index.html"
    },
    {
      "source": "/psychologische-veiligheid",
      "destination": "/psychologische-veiligheid/index.html"
    },
    {
      "source": "/sociale-veiligheid",
      "destination": "/sociale-veiligheid/index.html"
    },
    {
      "source": "/boven-en-onderstroom",
      "destination": "/boven-en-onderstroom/index.html"
    },
    {
      "source": "/brein-en-samenwerking",
      "destination": "/brein-en-samenwerking/index.html"
    },
    {
      "source": "/kleine-experimenten",
      "destination": "/kleine-experimenten/index.html"
    },
    {
      "source": "/kennis/eigenaarschap-in-teams",
      "destination": "/kennis/eigenaarschap-in-teams/index.html"
    },
    {
      "source": "/kennis/teamcultuur",
      "destination": "/kennis/teamcultuur/index.html"
    },
    {
      "source": "/kennis/teamenergie",
      "destination": "/kennis/teamenergie/index.html"
    },
    {
      "source": "/kennis/bevlogenheid-in-het-werk",
      "destination": "/kennis/bevlogenheid-in-het-werk/index.html"
    },
    {
      "source": "/kennis/verandermanagement",
      "destination": "/kennis/verandermanagement/index.html"
    },
    {
      "source": "/kennis/impact-van-een-teamdag",
      "destination": "/kennis/impact-van-een-teamdag/index.html"
    },
    {
      "source": "/kennis/kenniskaart-teamontwikkeling",
      "destination": "/kennis/kenniskaart-teamontwikkeling/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/blog",
      "destination": "/inspiratie",
      "permanent": true
    }
  ]
}
