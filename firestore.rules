rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          "bozidar@mijnteamkompas.nl",
          "edmond@mijnteamkompas.nl"
        ];
    }

    // Backoffice: beheerders mogen alles lezen en beheren
    match /klanten/{docId} {
      allow read, write: if isAdmin();
    }

    match /vragenlijsten/{docId} {
      allow read, write: if isAdmin();
    }

    match /metingen/{docId} {
      allow read, write: if isAdmin();
    }

    match /contactaanvragen/{docId} {
      allow read, write: if isAdmin();
      allow create: if true;
    }

    match /teamscanSelfserviceAanvragen/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /antwoorden/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /teamscanEvents/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    // Gratis scan wordt publiek uitsluitend via gevalideerde Cloud Functions benaderd.
    match /freeScanInstances/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    match /reflectiekaartLeads/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /nieuwsbriefAanmeldingen/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /prullenbak/{docId} {
      allow read, write: if isAdmin();
    }

    // Rapportages voor het klantportaal: alleen beheerders schrijven/lezen direct;
    // klanten krijgen ze via de Cloud Function (admin SDK).
    match /portalRapporten/{docId} {
      allow read, write: if isAdmin();
    }


    // ─────────────────────────────────────────────────────────────────────
    // Teamkompas app (/app): besloten samenwerkingsomgeving
    //
    // Uitgangspunt: brondata is privé en gedeelde data staat in een apart
    // document per team. Regels filteren geen velden — dat kan Firestore niet —
    // dus de scheiding zit in de structuur. Zie docs/APP-ARCHITECTUUR.md.
    // ─────────────────────────────────────────────────────────────────────

    function ingelogd() {
      return request.auth != null;
    }

    function ikBen(uid) {
      return ingelogd() && request.auth.uid == uid;
    }

    function isTeamlid(orgId, teamId) {
      return ingelogd() && exists(
        /databases/$(database)/documents/organisaties/$(orgId)/teams/$(teamId)/leden/$(request.auth.uid)
      );
    }

    // Een begeleider beheert het team net zo goed als een beheerder; het
    // verschil is dat hij er zelf niet aan meedoet. Dat onderscheid zit in wat
    // de app toont, niet in wat er mag.
    function isTeambeheerder(orgId, teamId) {
      return ingelogd() && get(
        /databases/$(database)/documents/organisaties/$(orgId)/teams/$(teamId)/leden/$(request.auth.uid)
      ).data.rol in ["beheerder", "begeleider"];
    }

    // Wie mag er zelf een organisatie met een team opzetten?
    //
    // De app is op uitnodiging. Zonder deze grens kon iedereen die een account
    // had een eigen organisatie beginnen, en stond er van alles in de database
    // dat niets met een begeleid team te maken had. Meedoen met een bestaand
    // team blijft gewoon open: daar heb je een geldige teamcode voor nodig.
    //
    // De lijst staat in Firestore, zodat er geen nieuwe uitrol van de regels
    // nodig is om iemand toe te voegen. De twee makers staan er los van, zodat
    // een lege of verwijderde lijst niemand buitensluit.
    match /begeleiders/{email} {
      // Je mag opvragen of jíj erop staat; de app verbergt de knop anders.
      allow get: if ingelogd() && request.auth.token.email == email;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    function magTeamsMaken() {
      return isAdmin() || (
        ingelogd() && exists(
          /databases/$(database)/documents/begeleiders/$(request.auth.token.email)
        )
      );
    }

    // Het eigen gebruikersdocument: naam, e-mail en de lijst met lidmaatschappen.
    // Niemand anders kan dit lezen, ook een teambeheerder niet.
    match /gebruikers/{uid} {
      allow read, write: if ikBen(uid);
    }

    // Een teamcode verwijst naar organisatie en team. Opvragen mag als je
    // ingelogd bent; doorzoeken niet, zodat codes niet te achterhalen zijn.
    //
    // Aanmaken mag alleen wie het team beheert waar de code naar wijst. Die
    // voorwaarde is niet theoretisch. Stond er alleen dat aangemaaktDoor gelijk
    // moest zijn aan je eigen uid, dan kon iedere ingelogde gebruiker die een
    // orgId en teamId kende zelf een code voor dat team wegschrijven, daarmee
    // een ledendocument aanmaken en zo bij alles komen wat dat team deelt. Een
    // verwijderd teamlid onthoudt die twee waarden moeiteloos, en kon zich op
    // die manier weer naar binnen schrijven.
    //
    // De code wordt daarom pas aangemaakt nadat het ledendocument van de
    // beheerder bestaat; zie maakOrganisatieMetTeam in opslag.js.
    match /teamcodes/{code} {
      allow get: if ingelogd();
      allow list: if false;
      allow create: if isTeambeheerder(
          request.resource.data.orgId,
          request.resource.data.teamId
        )
        && request.resource.data.aangemaaktDoor == request.auth.uid;
      // Bij wijzigen mag de code niet naar een ander team gaan wijzen: dan zou
      // een beheerder van zijn eigen team een geldige toegangscode voor het
      // team van een ander kunnen maken.
      allow update: if isTeambeheerder(resource.data.orgId, resource.data.teamId)
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.teamId == resource.data.teamId;
      allow delete: if isTeambeheerder(resource.data.orgId, resource.data.teamId);
    }

    match /organisaties/{orgId} {
      // Leesbaar voor wie lid is van een team binnen deze organisatie is niet
      // met één expressie te bepalen; daarom is de organisatie leesbaar voor
      // iedere ingelogde gebruiker. Er staat bewust niets gevoeligs in: alleen
      // een naam en het moment van aanmaken.
      allow get: if ingelogd();
      allow list: if false;
      allow create: if magTeamsMaken()
        && request.resource.data.eigenaar == request.auth.uid;
      allow update, delete: if ingelogd()
        && resource.data.eigenaar == request.auth.uid;

      match /teams/{teamId} {
        // Apart van het teamdocument: gewone teambeheerders krijgen niet
        // automatisch toegang tot de bespreeknotities van de begeleiders.
        function omgevingsbeheer() {
          return isTeamlid(orgId, teamId)
            && request.auth.uid in getAfter(/databases/$(database)/documents/organisaties/$(orgId)/teams/$(teamId)/teamomgeving/toegang).data.beheerders;
        }

        // De vorm van één documentregel. De sha256 is wat een download straks
        // tegen wordt gehouden, dus die moet er staan en moet een hash zijn --
        // een lege of verzonnen waarde zou betekenen dat de controle bij het
        // downloaden niets meer controleert.
        function nieuwDocument(d) {
          return d.keys().hasAll(['id', 'titel', 'naam', 'sha256', 'delen'])
            && d.keys().hasOnly(['id', 'titel', 'naam', 'sha256', 'delen', 'beschrijving'])
            && d.id is string && d.id.size() > 0 && d.id.size() <= 80 && d.id.matches('^[a-z0-9][a-z0-9-]*$')
            && d.titel is string && d.titel.size() > 0 && d.titel.size() <= 160
            && d.naam is string && d.naam.size() > 4 && d.naam.size() <= 160 && d.naam.matches('^[^/\\\\]+[.]pdf$')
            && d.sha256 is string && d.sha256.matches('^[a-f0-9]{64}$')
            && d.delen is int && d.delen >= 1 && d.delen <= 10;
        }

        match /teamomgeving/{onderdeel} {
          allow get: if isTeamlid(orgId, teamId)
            && (onderdeel in ['toegang', 'inhoud'] || (onderdeel == 'beheer' && omgevingsbeheer()));
          allow list: if false;
          // Eénmalige inrichting. De lijst kan niet vanuit de client worden
          // uitgebreid, overschreven of verwijderd, ook niet door een beheerder.
          allow create: if onderdeel == 'toegang' && isTeambeheerder(orgId, teamId)
            && request.resource.data.keys().hasOnly(['beheerders', 'aangemaaktDoor', 'versie'])
            && request.resource.data.versie == 1
            && request.resource.data.aangemaaktDoor == request.auth.uid
            && request.resource.data.beheerders is list
            && request.resource.data.beheerders.size() == 2
            && request.resource.data.beheerders[0] == request.auth.uid
            && request.resource.data.beheerders[1] is string
            && request.resource.data.beheerders[1] != request.auth.uid
            && exists(/databases/$(database)/documents/organisaties/$(orgId)/teams/$(teamId)/leden/$(request.resource.data.beheerders[1]));
          allow create: if onderdeel in ['inhoud', 'beheer'] && omgevingsbeheer();
          // De teksten mogen worden verbeterd, de rest van de omgeving niet.
          //
          // Wat hier niet in affectedKeys staat, kan dus niet mee veranderen:
          // documenten blijft zoals het is -- die metadata hoort bij de pdf's in
          // de aparte collectie, en wie hem mag herschrijven kan een download
          // naar andere inhoud laten wijzen. Toegang staat helemaal buiten deze
          // regel en blijft onveranderlijk.
          //
          // Wat er in een onderdeel staat wordt hier niet gecontroleerd: een
          // lijst van objecten is in regels niet te doorlopen. Dat is het werk
          // van valideerOmgeving in de client. Deze regel bewaakt wie er mag
          // schrijven, welke velden, en de grove vorm -- de dingen die een
          // client nooit over zichzelf mag beweren.
          allow update: if onderdeel == 'inhoud' && omgevingsbeheer()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['titel', 'intro', 'onderdelen', 'documentContext', 'bijgewerktOp', 'bijgewerktDoor'])
            && request.resource.data.titel is string
            && request.resource.data.titel.size() > 0
            && request.resource.data.titel.size() <= 160
            && request.resource.data.onderdelen is list
            && request.resource.data.onderdelen.size() >= 1
            && request.resource.data.onderdelen.size() <= 12
            && request.resource.data.bijgewerktOp == request.time
            && request.resource.data.bijgewerktDoor == request.auth.uid;
          // Een document toevoegen aan een omgeving die al staat.
          //
          // De documentenlijst lag vast na het inrichten, met reden: wie hem mag
          // herschrijven, kan een download naar andere inhoud laten wijzen dan
          // er is gecontroleerd. Maar een team maakt na een teamdag nieuwe
          // documenten, en die horen erbij.
          //
          // Dus mag er precies één bij, achteraan, en verandert er verder niets.
          // De vergelijking hieronder is letterlijk: de oude lijst met het
          // nieuwe element erachter moet gelijk zijn aan de nieuwe lijst. Een
          // andere titel bij een bestaand document, een andere sha256, een
          // andere volgorde -- het maakt die vergelijking allemaal onwaar, en
          // dan gaat er niets door. Verwijderen kan hiermee ook niet; dat is een
          // aparte beslissing, want de pdf-delen blijven anders als wees achter.
          allow update: if onderdeel == 'inhoud' && omgevingsbeheer()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['documenten', 'bijgewerktOp', 'bijgewerktDoor'])
            && resource.data.documenten is list
            && request.resource.data.documenten is list
            && request.resource.data.documenten.size() == resource.data.documenten.size() + 1
            && request.resource.data.documenten.size() <= 10
            && resource.data.documenten
                 .concat([request.resource.data.documenten[resource.data.documenten.size()]])
               == request.resource.data.documenten
            && nieuwDocument(request.resource.data.documenten[resource.data.documenten.size()])
            && request.resource.data.bijgewerktOp == request.time
            && request.resource.data.bijgewerktDoor == request.auth.uid;
          allow update: if onderdeel == 'beheer' && omgevingsbeheer()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notities', 'bijgewerktOp'])
            && request.resource.data.notities is string
            && request.resource.data.notities.size() <= 20000
            && request.resource.data.bijgewerktOp == request.time;
        }

        // Pdfs blijven in de bestaande beveiligde database, nooit als publieke
        // sitebestanden of langlevende downloadlinks. Delen blijven onder 1 MiB.
        match /teamomgevingBestanden/{bestandId}/delen/{deelId} {
          allow read: if isTeamlid(orgId, teamId);
          allow create: if omgevingsbeheer()
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 600000;
        }

        allow get: if isTeamlid(orgId, teamId);
        allow list: if false;
        allow create: if magTeamsMaken()
          && request.resource.data.aangemaaktDoor == request.auth.uid;
        allow update: if isTeambeheerder(orgId, teamId);
        allow delete: if isTeambeheerder(orgId, teamId);

        // Wie lid is van het team. Bevat naam en rol, geen profielinhoud.
        // Je voegt uitsluitend jezelf toe, en alleen met een kloppende teamcode.
        match /leden/{uid} {
          allow read: if isTeamlid(orgId, teamId);
          allow create: if ikBen(uid)
            && request.resource.data.rol in ["lid", "beheerder", "begeleider"]
            && (
              // De maker van het team beheert het ook — als beheerder die
              // meedoet, of als begeleider die dat niet doet.
              //
              // Die tweede voorwaarde is niet vrijblijvend. Zonder de controle
              // op aangemaaktDoor kon iedere ingelogde gebruiker een
              // ledendocument met rol "beheerder" wegschrijven onder een
              // wíllekeurig bestaand team, en zo het beheer van een team van
              // iemand anders overnemen — inclusief alles wat daar gedeeld is.
              // Het teamdocument wordt vlak vóór dit document aangemaakt, dus
              // voor de echte maker staat het er al.
              (
                request.resource.data.rol in ["beheerder", "begeleider"]
                && get(/databases/$(database)/documents/organisaties/$(orgId)/teams/$(teamId)).data.aangemaaktDoor == request.auth.uid
              )
              // Of iemand treedt toe met de juiste code, en dan als lid. Een
              // code is bedoeld om mee te doen, niet om te beheren.
              || (
                request.resource.data.rol == "lid"
                && get(/databases/$(database)/documents/teamcodes/$(request.resource.data.code)).data.teamId == teamId
                && get(/databases/$(database)/documents/teamcodes/$(request.resource.data.code)).data.orgId == orgId
              )
            );
          // Je eigen regel bijwerken mag — naam en functie — maar je rol niet.
          // Zonder die voorwaarde kon elk teamlid zichzelf beheerder maken door
          // rol: "beheerder" naar zijn eigen document te schrijven. Alleen een
          // beheerder kan een rol veranderen.
          allow update: if isTeambeheerder(orgId, teamId)
            || (ikBen(uid) && request.resource.data.rol == resource.data.rol);
          allow delete: if ikBen(uid) || isTeambeheerder(orgId, teamId);
        }

        // Alleen wat een gebruiker bewust deelt met dit team. Leesbaar voor
        // teamgenoten, schrijfbaar door de eigenaar. Intrekken is verwijderen.
        match /gedeeld/{uid} {
          allow read: if isTeamlid(orgId, teamId);
          allow write: if ikBen(uid) && isTeamlid(orgId, teamId);
        }

        // Een facilitator kan een Insights-profiel inlezen en als voorstel
        // klaarzetten voor een teamlid. Het is een voorstel en geen profiel:
        // het staat hier los, en alleen de persoon zelf kan het overnemen.
        // Naar profielen/{uid} blijft geen enkele weg lopen.
        // Profielen die een beheerder zelf toevoegt: voor mensen die nog geen
        // account hebben, of om een team compleet te maken bij een sessie. Ze
        // staan bewust in een eigen collectie. Naar profielen/{uid} van een
        // echte gebruiker loopt nog steeds geen enkele weg — dat blijft van de
        // eigenaar alleen, ook voor een beheerder.
        match /profielleden/{profielId} {
          allow read: if isTeamlid(orgId, teamId);
          allow create, update: if isTeambeheerder(orgId, teamId)
            && request.resource.data.toegevoegdDoor == request.auth.uid;
          allow delete: if isTeambeheerder(orgId, teamId);
        }

        // Wat het team met elkaar heeft afgesproken.
        //
        // Het enige in deze app dat van het team samen is in plaats van van één
        // persoon. Vandaar dat iedereen mag schrijven: een afspraak die alleen
        // de beheerder kan opschrijven is er een van bovenaf, en daar verliest
        // hij zijn kracht op.
        //
        // Twee dingen liggen wel vast. Wie hem oorspronkelijk opschreef blijft
        // staan, ook als iemand anders hem bijstelt — een afspraak waarvan de
        // herkomst kan veranderen is geen afspraak meer. En weghalen kan alleen
        // de beheerder, zodat er niets stilletjes van tafel verdwijnt.
        match /afspraken/{afspraakId} {
          allow read: if isTeamlid(orgId, teamId);
          allow create: if isTeamlid(orgId, teamId)
            && request.resource.data.doorUid == request.auth.uid
            && request.resource.data.tekst is string
            && request.resource.data.tekst.size() > 0
            && request.resource.data.tekst.size() <= 200;
          allow update: if isTeamlid(orgId, teamId)
            && request.resource.data.doorUid == resource.data.doorUid
            && request.resource.data.tekst is string
            && request.resource.data.tekst.size() > 0
            && request.resource.data.tekst.size() <= 200;
          allow delete: if isTeambeheerder(orgId, teamId);
        }

        // Tekst die een facilitator uit een teamsessie voor iemand klaarzet,
        // bestemd voor diens hand-in-handleiding. Eigen collectie, want het is
        // een eigen levensloop: het profielvoorstel komt uit een Insights-PDF
        // en verdwijnt zodra het is overgenomen, dit komt uit wat iemand zelf
        // in een sessie heeft opgeschreven en blijft staan tot die persoon zegt
        // dat hij ermee klaar is. Ze in één document stoppen zou betekenen dat
        // het overnemen van het ene het andere weggooit.
        //
        // Het is en blijft een voorstel: er wordt nooit in de handleiding van
        // iemand anders geschreven. Dat kan technisch ook niet — handleidingen
        // zijn alleen leesbaar en schrijfbaar voor de eigenaar zelf.
        match /handleidingvoorstellen/{uid} {
          allow get: if ikBen(uid) || isTeambeheerder(orgId, teamId);
          allow list: if isTeambeheerder(orgId, teamId);
          allow create, update: if isTeambeheerder(orgId, teamId)
            && exists(/databases/$(database)/documents/organisaties/$(orgId)/teams/$(teamId)/leden/$(uid))
            && request.resource.data.vanUid == request.auth.uid;
          allow delete: if ikBen(uid) || isTeambeheerder(orgId, teamId);
        }

        match /profielvoorstellen/{uid} {
          allow get: if ikBen(uid) || isTeambeheerder(orgId, teamId);
          allow list: if isTeambeheerder(orgId, teamId);
          allow create, update: if isTeambeheerder(orgId, teamId)
            && exists(/databases/$(database)/documents/organisaties/$(orgId)/teams/$(teamId)/leden/$(uid))
            && request.resource.data.vanUid == request.auth.uid;
          // Overnemen of weigeren betekent opruimen; de beheerder kan een
          // voorstel ook zelf weer intrekken.
          allow delete: if ikBen(uid) || isTeambeheerder(orgId, teamId);
        }
      }
    }

    // Brondata. Strikt privé: geen enkele andere gebruiker en geen enkele
    // beheerder kan hier iets lezen.
    match /profielen/{uid} {
      allow read, write: if ikBen(uid);

      match /kenmerken/{kenmerkId} {
        allow read, write: if ikBen(uid);
      }
    }

    match /handleidingen/{uid} {
      allow read, write: if ikBen(uid);

      match /secties/{sectieId} {
        allow read, write: if ikBen(uid);
      }
    }

    // Adviessessies zijn persoonlijk. We slaan alleen op dat een advies is
    // opgevraagd, bij welke situatie, of het bruikbaar was en — als het dat
    // niet was — wat er miste. Nooit over wie het ging of wat er stond.
    //
    // Een teambeheerder kan hier niet bij, en dat is geen omissie. Zou een
    // leidinggevende kunnen zien wie welk advies opvroeg, dan vraagt niemand
    // nog advies over wat er echt speelt.
    //
    // De makers van de app mogen de hele collectie wel lezen, want dit is de
    // enige manier om te zien welke adviezen raak zijn en welke niet.
    match /adviessessies/{sessieId} {
      allow get: if isAdmin() || (ingelogd() && resource.data.uid == request.auth.uid);
      allow create: if ingelogd() && request.resource.data.uid == request.auth.uid;
      allow update: if ingelogd() && resource.data.uid == request.auth.uid;
      allow delete: if ingelogd() && resource.data.uid == request.auth.uid;
      // Doorzoeken kan de makers, en verder alleen jezelf in je eigen sessies.
      // Dat laatste is nodig om ze te kunnen exporteren en verwijderen: zonder
      // die regel bewaart de app iets van je dat je zelf niet kunt vinden.
      // Firestore keurt een zoekopdracht in zijn geheel af zodra er één
      // document uit zou komen dat deze regel niet doorstaat, dus een lijst
      // zonder filter op de eigen uid mislukt gewoon.
      allow list: if isAdmin() || (ingelogd() && resource.data.uid == request.auth.uid);
    }

    // Een experiment: één kleine actie die je dertig dagen probeert.
    //
    // Strikt van jou, en van niemand anders — ook niet van de makers. Een
    // adviessessie mogen zij opgeteld inzien omdat daar niets persoonlijks in
    // staat; hier staat wel iets persoonlijks: wat jij aan jezelf probeert te
    // veranderen en wat je daarvan vond. Zodra iemand daarover meekijkt wordt
    // een experiment een prestatie, en dan doet niemand het meer eerlijk.
    match /experimenten/{experimentId} {
      allow get: if ingelogd() && resource.data.uid == request.auth.uid;
      allow list: if ingelogd() && resource.data.uid == request.auth.uid;
      allow create: if ingelogd()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.actie is string
        && request.resource.data.actie.size() > 0
        && request.resource.data.actie.size() <= 400;
      allow update: if ingelogd()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if ingelogd() && resource.data.uid == request.auth.uid;
    }

    // Terugkijken op een gesprek dat je hebt gevoerd. Net zo dicht als een
    // experiment, en om dezelfde reden: hier staan je eigen woorden over hoe
    // iets ging. Bij welke situatie het was staat erbij, met wie het gesprek
    // was niet — dat weet de app ook niet.
    match /reflecties/{reflectieId} {
      allow get: if ingelogd() && resource.data.uid == request.auth.uid;
      allow list: if ingelogd() && resource.data.uid == request.auth.uid;
      allow create: if ingelogd()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.terugblik is string
        && request.resource.data.terugblik.size() > 0
        && request.resource.data.terugblik.size() <= 40;
      allow update: if ingelogd()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if ingelogd() && resource.data.uid == request.auth.uid;
    }

    // Alles wat niet expliciet hierboven staat, blijft dicht
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
