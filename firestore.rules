rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          "bozidar@mijnteamkompas.nl",
          "edmond@mijnteamkompas.nl"
        ];
    }

    // Backoffice: beheerders mogen alles lezen en beheren.
    // Klantportaal: een ingelogde klant mag alleen zijn eigen klantrecord
    // en de bijbehorende documenten lezen (koppeling via portalEmail).
    match /klanten/{docId} {
      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.portalEmail is string
            && resource.data.portalEmail != ""
            && resource.data.portalEmail == request.auth.token.email);
      allow write: if isAdmin();

      match /documenten/{documentId} {
        allow read: if isAdmin()
          || (request.auth != null
              && get(/databases/$(database)/documents/klanten/$(docId)).data.portalEmail == request.auth.token.email);
        allow write: if isAdmin();
      }
    }

    match /vragenlijsten/{docId} {
      allow read, write: if isAdmin();
    }

    match /metingen/{docId} {
      allow read, write: if isAdmin();
    }

    match /contactaanvragen/{docId} {
      allow read, write: if isAdmin();
      allow create: if true;
    }

    match /teamscanSelfserviceAanvragen/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /antwoorden/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /teamscanEvents/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /reflectiekaartLeads/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /nieuwsbriefAanmeldingen/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /prullenbak/{docId} {
      allow read, write: if isAdmin();
    }

    // Alles wat niet expliciet hierboven staat, blijft dicht
    match /{document=**} {
      allow read, write: if false;
    }
  }
}